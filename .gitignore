# =============================================================================
# SECRETS & CREDENTIALS — never commit these
# =============================================================================
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt
*.der
*.ppk
*.asc
*.gpg
*.keystore
*.jks
id_rsa
id_ed25519
id_ecdsa
*.secret
secrets/
.secrets/
credentials/
.credentials/
# Cloudflare secrets (set via wrangler secret put, never in files)
.dev.vars
.dev.vars.*
!.dev.vars.example


# =============================================================================
# DEPENDENCIES
# =============================================================================
node_modules/
.pnp
.pnp.js
.pnp.cjs


# =============================================================================
# BUILD OUTPUTS
# =============================================================================
dist/
build/
out/
.output/
# Vite
.vite/
# Wrangler / Cloudflare Workers
.wrangler/
# Python
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg
*.egg-info/
dist-info/
.eggs/
# GitHub Actions local runner artifacts
_work/


# =============================================================================
# CACHES
# =============================================================================
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.prettiercache
.turbo/
.rollup.cache/
*.tsbuildinfo
# Python caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
__pypackages__/
.hypothesis/
# uv
.uv/
# pnpm
.pnpm-store/


# =============================================================================
# TEST & COVERAGE OUTPUTS
# =============================================================================
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/
blob-report/
e2e-results/


# =============================================================================
# LOGS
# =============================================================================
*.log
*.log.*
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# =============================================================================
# RUNTIME / TEMP FILES
# =============================================================================
*.tmp
*.temp
*.swp
*.swo
*~
.tmp/
temp/
tmp/


# =============================================================================
# OS FILES
# =============================================================================
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Icon?
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
# Linux
.directory
.Trash-*


# =============================================================================
# EDITORS & IDEs
# =============================================================================
.idea/
*.iml
*.iws
*.ipr
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
# VSCode — keep .vscode/settings.json and .vscode/extensions.json, but ignore personal state
.vscode/launch.json
.vscode/*.code-workspace
.history/


# =============================================================================
# CLOUDFLARE / WRANGLER
# =============================================================================
# Worker build outputs (already covered by dist/ but explicit for clarity)
workers/*/dist/
workers/*/.wrangler/
# Wrangler state (local dev sqlite, D1, KV, R2 emulation)
.wrangler/state/


# =============================================================================
# GITHUB ACTIONS — local act runner
# =============================================================================
.act/


# =============================================================================
# PYTHON (GitHub Actions scripts)
# =============================================================================
.venv/
venv/
env/
.python-version
*.pyc
*.pyd
# uv lockfiles are intentionally committed; skip virtual envs only
# Keep: uv.lock, pyproject.toml


# =============================================================================
# MONOREPO — pnpm
# =============================================================================
# The lockfile IS committed — do not ignore pnpm-lock.yaml
# Ignore only local pnpm state
.pnpm-debug.log*
