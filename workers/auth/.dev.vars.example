# =============================================================================
# MOREL AUTH WORKER — Environment variables
# =============================================================================
# For local dev: copy to .dev.vars and fill in values from Infisical.
# Secrets (GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, GITHUB_APP_ID, SENTRY_DSN)
# must be obtained from Infisical — never put real values in this file.
# For staging / production: push secrets with:
#   wrangler secret put <KEY> --env <staging|production>
# DO NOT commit files without the .example suffix.

# GitHub App ID (number shown on the app settings page).
# Secret — get from Infisical /worker
GITHUB_APP_ID=

# GitHub App Client ID.
# Secret — get from Infisical /worker
GITHUB_CLIENT_ID=

# GitHub App Client Secret.
# Secret — get from Infisical /worker
GITHUB_CLIENT_SECRET=

# Comma-separated list of allowed CORS origins.
# dev: http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Sentry DSN for worker error reporting.
# Leave empty in dev to suppress Sentry noise from local machines.
SENTRY_DSN=
