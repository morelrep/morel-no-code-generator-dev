# =============================================================================
# MOREL AUTH WORKER (workers/auth) — Environment variables
# =============================================================================
# For local dev: copy this file to .dev.vars and fill in secrets from Infisical.
# For staging / production: secrets are synced automatically via the
# Infisical → Cloudflare Workers integration (no manual wrangler secret put needed).
# DO NOT commit files without the .example suffix.
#
# Source of truth: Infisical project → environment → /worker
# Infisical project ID: 86b469f7-276d-49f9-8795-472e793cdaf0
#
# NOTE: GITHUB_DEVICE_CODE_URL and GITHUB_DEVICE_TOKEN_URL are public constants
# hardcoded in wrangler.toml [vars] — they do not belong in Infisical or here.

# ---------------------------------------------------------------------------
# GitHub App — secrets (get from Infisical /worker)
# ---------------------------------------------------------------------------

# Numeric App ID shown at the top of the GitHub App settings page.
GITHUB_APP_ID=

# Client ID of the GitHub App for this environment.
# dev + staging: Morel Studio Dev app
# production:    Morel Studio app
GITHUB_CLIENT_ID=

# Client Secret of the GitHub App.
# Required for the OAuth web flow token exchange.
GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------

# Comma-separated list of allowed origins.
# dev:        http://localhost:5173
# staging:    https://morel-auth-staging.delpinoivivas.workers.dev,http://localhost:5173
# production: https://morel-auth.delpinoivivas.workers.dev
ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Monitoring
# ---------------------------------------------------------------------------

# Sentry DSN for worker error reporting.
# Leave empty in dev to suppress noise from local machines.
# Get from: sentry.io → project settings → Client Keys (DSN)
SENTRY_DSN=

# ---------------------------------------------------------------------------
# OAuth web flow — environment-specific redirect URI (get from Infisical /worker)
# ---------------------------------------------------------------------------

# Must match the callback URL registered in the GitHub App settings exactly.
# Note: GITHUB_OAUTH_TOKEN_URL is a public constant in wrangler.toml [vars] — not here.
GITHUB_OAUTH_REDIRECT_URI=http://localhost:5173/auth/callback

# ---------------------------------------------------------------------------
# Future variables (not yet in use)
# ---------------------------------------------------------------------------

# GitHub App private key in PEM format — needed only if the worker ever
# authenticates as the App itself (e.g. installation access tokens for
# server-side repo operations). Not required for device flow or OAuth web flow.
# GITHUB_APP_PRIVATE_KEY=
