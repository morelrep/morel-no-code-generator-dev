# =============================================================================
# MOREL STUDIO (apps/web) — Environment variables
# =============================================================================
# Copy this file to .env.development / .env.staging / .env.production
# and fill in real values from Infisical (path: /web).
# DO NOT commit files without the .example suffix.
#
# Source of truth: Infisical project → environment → /web
# Infisical project ID: 86b469f7-276d-49f9-8795-472e793cdaf0

# ---------------------------------------------------------------------------
# Auth Gateway
# ---------------------------------------------------------------------------

# Base URL of the MOREL Auth Worker for this environment.
# dev:        http://localhost:8787
# staging:    https://morel-auth-staging.delpinoivivas.workers.dev
# production: https://morel-auth.delpinoivivas.workers.dev
VITE_MOREL_AUTH_GATEWAY_URL=

# ---------------------------------------------------------------------------
# GitHub App
# ---------------------------------------------------------------------------

# GitHub App Client ID for this environment.
# dev + staging: Morel Studio Dev app
# production:    Morel Studio app
VITE_GITHUB_CLIENT_ID=

# ---------------------------------------------------------------------------
# Monitoring
# ---------------------------------------------------------------------------

# Sentry DSN for frontend error reporting.
# Leave empty in dev to suppress noise from local machines.
# Get from: sentry.io → project settings → Client Keys (DSN)
VITE_SENTRY_DSN=

# ---------------------------------------------------------------------------
# Future variables (not yet in use)
# ---------------------------------------------------------------------------

# PostHog ingestion proxy URL — add when product analytics are enabled.
# Will route to events.morel.<domain> → PostHog proxy.
# VITE_POSTHOG_HOST=

# PostHog project API key.
# VITE_POSTHOG_KEY=
