# =============================================================================
# MOREL STUDIO — Environment variables
# =============================================================================
# Copy this file to .env.development / .env.staging / .env.production
# and fill in real values from Infisical (path: /web).
# DO NOT commit files without the .example suffix.

# URL of the MOREL Auth Gateway worker for this environment.
# dev:        http://localhost:8787
# staging:    https://morel-auth-staging.<account>.workers.dev
# production: https://morel-auth.<account>.workers.dev
VITE_MOREL_AUTH_GATEWAY_URL=

# GitHub App / OAuth App Client ID for this environment.
# Use the dev/staging app for dev + staging; the prod app for production.
VITE_GITHUB_CLIENT_ID=

# Sentry DSN for frontend error reporting.
# Leave empty in dev to suppress Sentry noise from local machines.
VITE_SENTRY_DSN=
