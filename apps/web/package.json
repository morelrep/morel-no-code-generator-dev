{
  "name": "@morel/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "infisical export --env=dev --path=/apps/web --format=dotenv > .env.local && (trap 'rm -f .env.local' EXIT INT TERM; vite)",
    "build": "infisical export --env=dev --path=/apps/web --format=dotenv > .env.local && (trap 'rm -f .env.local' EXIT INT TERM; tsc -b && vite build)",
    "build:ci": "tsc -b && vite build",
    "preview": "infisical export --env=dev --path=/apps/web --format=dotenv > .env.local && (trap 'rm -f .env.local' EXIT INT TERM; vite preview)",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "echo \"tests not configured yet\"",
    "clean": "rm -rf dist .vite"
  },
  "dependencies": {
    "@octokit/rest": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "radix-ui": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "tailwind-merge": "catalog:",
    "lucide-react": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "globals": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:"
  }
}
