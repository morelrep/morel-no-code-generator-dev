{
  // ── Package manager ──────────────────────────────────────────────────────────
  "npm.packageManager": "pnpm",

  // ── TypeScript: use the local TS 6 instead of VS Code's bundled version ──────
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,

  // ── Formatting ───────────────────────────────────────────────────────────────
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
      "source.organizeImports": "explicit"
    }
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
      "source.organizeImports": "explicit"
    }
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "editor.formatOnSaveMode": "file",

  // ── Markdown: mdformat on save (global uv tool) ──────────────────────────────
  "emeraldwalk.runonsave": {
    "commands": [
      {
        "match": "\\.mdx?$",
        "cmd": "~/.local/bin/mdformat --number --compact-tables --no-validate \"${file}\""
      }
    ]
  },
  "markdown.validate.enabled": true,

  // ── CSS: suppress false positives for Tailwind v4 at-rules ──────────────────
  "css.lint.unknownAtRules": "ignore",

  // ── Misc ─────────────────────────────────────────────────────────────────────
  "search.exclude": {
    "**/node_modules": true,
    "**/.pnpm-store": true
  }
}
